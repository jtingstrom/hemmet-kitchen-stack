# Copy to ".env" before running `docker compose up -d`.
# .env stays out of git (see .gitignore) because it holds your API token.

TZ=Europe/Stockholm

# Network binding. Defaults = this computer only. To reach the apps from a
# phone/tablet on your LAN, use the computer's LAN IP (or 0.0.0.0).
MEALIE_BIND=127.0.0.1
MEALIE_PORT=9000
MODULER_BIND=127.0.0.1
MODULER_PORT=8080

# Address Mealie itself believes it lives at, and the address your browser
# uses for images and "Open in Mealie" links. Keep both in sync with the
# binding above (e.g. http://192.168.1.20:9000).
BASE_URL=http://localhost:9000
MEALIE_PUBLIC_URL=http://localhost:9000

ALLOW_SIGNUP=false
PUID=1000
PGID=1000

# Create in Mealie: profile picture -> Profile -> API tokens -> Create.
# Leave empty on the very first start, create the token, then fill it in and
# run `docker compose up -d` again.
MEALIE_API_TOKEN=

# Only if "Open in Mealie" links give 404 (your Mealie group is not "home"):
# look at the URL of a recipe page, e.g. http://localhost:9000/g/MY-GROUP/r/x
# MEALIE_GROUP_SLUG=home
